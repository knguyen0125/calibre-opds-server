{
  "name": "calibre-opds-server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "elysia": "^1.4.30",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.12",
    "sharp": "^0.34.4"
  },
  "scripts": {
    "dev": "bun --watch index.ts",
    "build": "bun build --compile index.ts --outfile dist/calibre-opds-server",
    "build:linux":
      "bun build --compile --target=bun-linux-x64 index.ts --outfile dist/calibre-opds-server-linux-x64"
  }
}
